{
  "name": "app-ef-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "app_ef frontend — a semantic-search corpus UI built on acture (command dispatch) + zodal (schema-driven UI), over the ef.EfService HTTP backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/openapi.d.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@zodal/core": "^0.1.2",
    "@zodal/store": "^0.1.2",
    "@zodal/ui": "^0.1.2",
    "@zodal/ui-shadcn": "^0.1.0",
    "acture": "^1.3.1",
    "acture-ai-vercel": "^1.1.0",
    "acture-hotkeys": "^1.1.1",
    "acture-palette-react": "^1.0.1",
    "ai": "^4.3.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "acture-e2e-playwright": "^1.1.0",
    "autoprefixer": "^10.7.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
